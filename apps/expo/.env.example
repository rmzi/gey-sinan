# API Configuration
# Default: http://localhost:8000/api/v1/
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1/

# Google Apps Script web app URL for "suggest a fix" submissions.
# See docs/volunteer/google-sheet-setup.md for how to create this.
# If unset, the suggest-a-fix form is disabled.
EXPO_PUBLIC_FEEDBACK_URL=

# Presigned-URL endpoint for volunteer audio uploads to S3.
# Expected: GET ?speakerId=&wordId=&contentType= -> { url, key }
EXPO_PUBLIC_UPLOAD_URL=
